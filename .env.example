# Copy to .env for local tooling. The site has no backend: the browser only
# receives JSON from data/, and a key placed here is read by local scripts
# only (see the AI section at the bottom), never shipped to a page.

# Directory containing the JSON data files.
# OPEN_TOOL_HUB_DATA_DIR=./data

# Static site directory that build_site.py stages and serves.
# OPEN_TOOL_HUB_SITE_DIR=./site

# Host and port for: python3 scripts/build_site.py --serve
# OPEN_TOOL_HUB_HOST=127.0.0.1
# OPEN_TOOL_HUB_PORT=8000

# --- Optional local AI ------------------------------------------------------
# The published site never calls a model. These variables only affect
# scripts/ai_chat.py and the optional local proxy (scripts/ai_proxy.py).
# See docs/local-ai.md. Keys are read from the environment only: a config file
# may name the variable that holds a key, never contain the key itself.

# Fallback order for the provider chain, first is tried first.
# OPEN_TOOL_HUB_AI_PROVIDERS=local,cloud

# Optional JSON config, same fields as the OPEN_TOOL_HUB_AI_* variables.
# ai-providers.local.json is gitignored and picked up automatically.
# OPEN_TOOL_HUB_AI_CONFIG=./ai-providers.local.json

# Bind address for scripts/ai_proxy.py (loopback only unless --allow-remote).
# OPEN_TOOL_HUB_AI_HOST=127.0.0.1
# OPEN_TOOL_HUB_AI_PORT=8787

# A local Ollama server needs no key.
# OPEN_TOOL_HUB_AI_LOCAL_KIND=ollama
# OPEN_TOOL_HUB_AI_LOCAL_MODEL=phi3:mini
# OPEN_TOOL_HUB_AI_LOCAL_BASE_URL=http://127.0.0.1:11434

# A hosted provider: the key stays in this file's sibling .env, never in JSON.
# OPEN_TOOL_HUB_AI_CLOUD_KIND=openai
# OPEN_TOOL_HUB_AI_CLOUD_MODEL=gpt-4o-mini
# OPEN_TOOL_HUB_AI_CLOUD_API_KEY_ENV=OPENAI_API_KEY
# OPEN_TOOL_HUB_AI_CLOUD_TIMEOUT=60
# OPEN_TOOL_HUB_AI_CLOUD_MAX_TOKENS=512
# OPENAI_API_KEY=

